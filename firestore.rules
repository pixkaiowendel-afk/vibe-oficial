rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGerente() {
      return isSignedIn() && request.auth.token.email == "kaiow631@gmail.com";
    }

    // Master Gate: Check membership of a conversation
    function isConversationParticipant(conversationId) {
      return isSignedIn() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    // Static Type Validators
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'verified']) &&
             data.keys().size() >= 3 && data.keys().size() <= 20 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.verified is bool &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 150)) &&
             (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!data.keys().hasAny(['role']) || (data.role is string && data.role.size() <= 100)) &&
             (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100)) &&
             (!data.keys().hasAny(['links']) || (data.links is list && data.links.size() <= 10)) &&
             (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 200000)) &&
             (!data.keys().hasAny(['status']) || (data.status is string && (data.status == 'online' || data.status == 'offline' || data.status == 'typing' || data.status == 'recording'))) &&
             (!data.keys().hasAny(['simulatedPassword']) || (data.simulatedPassword is string && data.simulatedPassword.size() <= 200)) &&
             (!data.keys().hasAny(['bannedStatus']) || (data.bannedStatus is string && data.bannedStatus.size() <= 50)) &&
             (!data.keys().hasAny(['bannedUntil']) || (data.bannedUntil is string && data.bannedUntil.size() <= 100));
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'title', 'isGroup', 'category', 'participantIds']) &&
             data.keys().size() >= 5 && data.keys().size() <= 13 &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 150 &&
             data.isGroup is bool &&
             data.category is string && (data.category == 'direct' || data.category == 'group' || data.category == 'ai' || data.category == 'verified') &&
             data.participantIds is list && data.participantIds.size() <= 100 &&
             (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 2000)) &&
             (!data.keys().hasAny(['verified']) || (data.verified is bool)) &&
             (!data.keys().hasAny(['pinned']) || (data.pinned is bool)) &&
             (!data.keys().hasAny(['participants']) || (data.participants is list)) &&
             (!data.keys().hasAny(['unreadCount']) || (data.unreadCount is number)) &&
             (!data.keys().hasAny(['messages']) || (data.messages is list));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'timestamp', 'date', 'status']) &&
             data.keys().size() >= 6 && data.keys().size() <= 16 &&
             data.id is string && data.id.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.timestamp is string && data.timestamp.size() <= 10 &&
             data.date is string && data.date.size() <= 15 &&
             data.status is string && (data.status == 'sent' || data.status == 'delivered' || data.status == 'read') &&
             (!data.keys().hasAny(['text']) || (data.text is string && data.text.size() <= 5000)) &&
             (!data.keys().hasAny(['audioUrl']) || (data.audioUrl is string && data.audioUrl.size() <= 500000)) &&
             (!data.keys().hasAny(['audioDuration']) || (data.audioDuration is number)) &&
             (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 1000000)) &&
             (!data.keys().hasAny(['videoUrl']) || (data.videoUrl is string && data.videoUrl.size() <= 2000000)) &&
             (!data.keys().hasAny(['isAiResponse']) || (data.isAiResponse is bool)) &&
             (!data.keys().hasAny(['deletedForEveryone']) || (data.deletedForEveryone is bool)) &&
             (!data.keys().hasAny(['deletedByUsers']) || (data.deletedByUsers is list));
    }

    // 1. Users Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // restricted to checking other vibe profiles
      allow create: if isSignedIn() && (
                      isGerente() || 
                      (isOwner(userId) && isValidUser(incoming()) && incoming().verified == false)
                    );
      allow update: if isSignedIn() && (
                      isGerente() || 
                      (isOwner(userId) && isValidUser(incoming()) && 
                       incoming().verified == existing().verified && // block self-verifying
                       (!existing().keys().hasAny(['email']) || incoming().email == existing().email)) // block email modification
                    );
    }

    // 2. Conversations Rules
    match /conversations/{conversationId} {
      // allow read only if user is listed in participantIds or if it is a public/AI channel containing general templates
      allow get, read: if isSignedIn() && 
                       (resource == null || request.auth.uid in resource.data.participantIds || resource.data.category == 'ai');
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantIds || resource.data.category == 'ai');
      
      allow create: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming()) &&
                    (request.auth.uid in incoming().participantIds);

      allow update: if isSignedIn() && isValidConversation(incoming()) && 
                    (request.auth.uid in existing().participantIds) &&
                    incoming().get('verified', false) == existing().get('verified', false) && // preserve premium badge
                    incoming().id == existing().id;
      
      allow delete: if isSignedIn() && (request.auth.uid in existing().participantIds);
      
      // 3. Subcollection messages rules inside a conversation
      match /messages/{messageId} {
        allow get, list, read: if isSignedIn() && isConversationParticipant(conversationId);
        
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                      isConversationParticipant(conversationId) &&
                      (incoming().senderId == request.auth.uid ||
                       incoming().senderId == 'vibe' || 
                       (conversationId == 'aria-ai_' + request.auth.uid && (incoming().senderId == 'aria' || incoming().senderId == 'aria-ai')) ||
                       (conversationId == 'lucas-personal_' + request.auth.uid && incoming().senderId == 'lucas') ||
                       (conversationId == 'sabrina-designer_' + request.auth.uid && incoming().senderId == 'sabrina') ||
                       (conversationId == 'squad-vibe_' + request.auth.uid && incoming().senderId in ['aria', 'aria-ai', 'lucas', 'sabrina']));
        
        allow update: if isSignedIn() && isConversationParticipant(conversationId) && 
                      isValidMessage(incoming()) &&
                      // only allow updating status, reactions, text, audioUrl, audioDuration, imageUrl, videoUrl, deletedForEveryone, deletedByUsers
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reactions', 'text', 'audioUrl', 'audioDuration', 'imageUrl', 'videoUrl', 'deletedForEveryone', 'deletedByUsers']) &&
                      incoming().senderId == existing().senderId;

        allow delete: if false; // do not allow deleting individual items to maintain communication integrity
      }
    }

    // 4. Client WebRTC Live Voice Calls signaling
    match /live_calls/{callId} {
      allow read, write, delete: if isSignedIn();
    }
  }
}
