{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile inside the Vibe chat platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Auth UID of the user" },
        "name": { "type": "string", "description": "Display name" },
        "avatar": { "type": "string", "description": "Profile picture URL" },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "Current status" },
        "verified": { "type": "boolean", "description": "Is official or verified user" },
        "role": { "type": "string", "description": "Optional title or bio tag" },
        "bio": { "type": "string", "description": "Short description of user" },
        "category": { "type": "string", "description": "User business or personal bio category like Designer, Developer, Gamer" },
        "links": { "type": "array", "description": "Custom links profile section" },
        "email": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Join timestamp" }
      },
      "required": ["id", "name", "email", "verified"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A conversation room, either direct message or group channel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Conversation unique ID" },
        "title": { "type": "string", "description": "Channel or user display title" },
        "isGroup": { "type": "boolean", "description": "Is a multi-user group chat" },
        "avatar": { "type": "string", "description": "Group thumbnail or contact avatar" },
        "verified": { "type": "boolean", "description": "Is verified group or agent room" },
        "category": { "type": "string", "enum": ["direct", "group", "ai", "verified"], "description": "Conversation category filter" },
        "pinned": { "type": "boolean", "description": "Is pinned at top" },
        "participantIds": { "type": "array", "description": "Uids of users participating" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "Creator of group/chat" }
      },
      "required": ["id", "title", "isGroup", "category", "participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "A communication bubble within a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message id" },
        "senderId": { "type": "string", "description": "UID of sender" },
        "senderName": { "type": "string", "description": "Cached display name of sender" },
        "text": { "type": "string", "description": "Optional text content" },
        "audioUrl": { "type": "string", "description": "Base64 or secure audio URL" },
        "audioDuration": { "type": "number", "description": "Audio message length in seconds" },
        "imageUrl": { "type": "string", "description": "Optional picture attachment" },
        "timestamp": { "type": "string", "description": "Formatting time HH:MM" },
        "date": { "type": "string", "description": "Formatting date YYYY-MM-DD" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"], "description": "Delivery status indicator" },
        "isAiResponse": { "type": "boolean", "description": "True if AI helper answered" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server order clock" }
      },
      "required": ["id", "senderId", "senderName", "timestamp", "date", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account documents mapped by Firebase Auth UID"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Premium chat threads and groups"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Unbounded subcollection for message history log inside a specific conversation room"
    }
  }
}
